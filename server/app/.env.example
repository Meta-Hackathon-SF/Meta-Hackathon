# Examples only. The application reads process environment, not this file automatically.
CONSTELLATIONS_ENV=development
CONSTELLATIONS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production requires an explicit origin list. Do not use a wildcard with sessions.
# No Muse, database, or session credentials are required for the P0 health endpoint.

# Set server-only values privately before running the configured weekly factory.
# CONSTELLATIONS_WORKFLOW_DSN: PostgreSQL LOGIN inheriting workflow_runtime.
# CST_PRIVACY_DB: absolute path outside the checkout to the SQLite privacy file.
# Muse configuration remains Adam's server-only adapter configuration.
