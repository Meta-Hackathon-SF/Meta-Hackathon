# Server-only Muse configuration. Copy outside Git; never prefix with VITE_.
MUSE_API_KEY=replace-me
MUSE_MODEL=muse-spark-1.3
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_TIMEOUT_S=30
MUSE_MAX_ATTEMPTS=2
# Optional; unset uses the provider default ("high"). "none" is rejected by the provider.
# MUSE_REASONING_EFFORT=low
